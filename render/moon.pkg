// render：软件光栅——形状覆盖（子采样 AA）、仿射变换、7 种混合、
// 位图采样、取景渲染、pick、统计。
// 依赖 core（IR）、codec（RgbaBuf/PNG）与 pixel（MVSL 编辑表作为最终一遍：
// 层合成出底图 → 施加编辑表 → 再裁剪缩放。方向 base ← codec ← core ←
// pixel ← render 无环，pixel 不反向依赖 render）。

import {
  "moonpainter/core",
  "moonpainter/codec",
  "moonpainter/pixel",
  // 色阶的 gamma 要真实幂函数（`Double::pow` 已弃用，用标准库的 `@math.pow`；
  // 自写级数在这个量级上没有好处，而标准库是纯 MoonBit、两个 target 都支持）
  "moonbitlang/core/math",
}

import {
  "moonpainter/base",
} for "test"
