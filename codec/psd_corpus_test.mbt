///|
/// **生成的 PSD 语料表**（`tools/make_psd_corpus.py`；psd-tools 1.24.0 / Pillow 12.3.0）。
/// 别手改：语料与期望值是**第三方实现**（psd-tools 写、Pillow + psd-tools 读）算出来的，
/// 重新生成后跑 `python3 tools/make_psd_corpus.py --check`（用 venv 的 python）确认幂等。
///
/// ⚠️ 这张表是 `_test.mbt`（只在测试编译时进包）：`.psd` 文件本身也提交在
/// `codec/testdata/psd/`，`verify.sh#psd-corpus` 走 CLI 用同一批文件。
///
/// 一层语料的期望（层表 + 每层 RGBA 的 sha256）。
pub struct PsdLayerCase {
  name : String
  x : Int
  y : Int
  w : Int
  h : Int
  opacity : Int
  visible : Bool
  blend : String
  rgba_sha : String
}

///|
/// 一例 PSD 语料（`b64` 是文件字节；期望值来自第三方实现）。
pub struct PsdCase {
  name : String
  file : String
  b64 : String
  width : Int
  height : Int
  composite_sha : String
  layers : Array[PsdLayerCase]
}

///|
/// 一例**必须被拒绝**的边界样本（`want` = 错误里必须出现的话）。
pub struct PsdBadCase {
  name : String
  file : String
  b64 : String
  want : String
  note : String
}

